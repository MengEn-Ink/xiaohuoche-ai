# ---- 微信公众号（个人主体：仅 draft/add 草稿箱，群发需手机人工）----
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 公众号后台「基本配置」里把运行机器公网 IP 加入白名单

# ---- Strava 官方 API（俱乐部活动 / PR / 路段成绩）----
# 申请：https://www.strava.com/settings/api ，OAuth 拿到 refresh_token
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
# 可选；默认写入 data/.strava_token.json，持久化 Strava 轮换后的 refresh_token
STRAVA_TOKEN_CACHE=./data/.strava_token.json
STRAVA_CLUB_URL=https://www.strava.com/clubs/Team_XZQ
STRAVA_CLUB_ID=780580

# ---- LLM（写作 + 多模态 OCR）----
# 兼容 OpenAI Chat Completions 协议即可：豆包/DeepSeek/OpenAI/各家中转 等
# 注意 base_url 要写到 /v1 这一级，程序自己拼 /chat/completions
# 例：LLM_BASE_URL=https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_VISION_MODEL=

# ---- 路径 ----
# 素材筐：群照片 + 群聊截图丢这里
XHC_INBOX_DIR=./data/inbox
XHC_WORK_DIR=./data/articles
